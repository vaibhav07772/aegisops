# === App ===
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false
APP_NAME=AegisOps
APP_VERSION=0.1.0

# === LLM (Groq) ===
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000
USE_LLM_REASONER=true

# === MLflow ===
MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=aegisops-anomaly

# === RAG ===
CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVER_TOP_K=10
RERANKER_TOP_K=5
RAG_ENABLED=true

# === Database ===
DATABASE_URL=sqlite:///./data/aegisops.db

# === Guardrails ===
PII_REDACTION_ENABLED=true
DANGEROUS_COMMANDS_BLOCKED=true

# === Docker (optional) ===
# Uncomment when running via docker-compose if you need cross-container API URL
# AEGISOPS_API=http://api:8000